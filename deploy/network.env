# Physical 10 GbE loopback causes target lockups; use the isolated software link.
BEV_LINK_MODE=software
BEV_LINK_IFACE=bev-host
BEV_EDGE_IFACE=bev-edge0
BEV_HOST_ADDRESS=10.77.0.1
BEV_WORKER_URL=http://10.77.0.2:9001
BEV_WORKER_HOST=10.77.0.2
BEV_LINK_CAPACITY=1000
BEV_DISABLED_PORTS=mgbe2_0,mgbe3_0
